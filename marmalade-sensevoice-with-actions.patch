diff --git a/.github/workflows/build-sensevoice.yml b/.github/workflows/build-sensevoice.yml
new file mode 100644
index 0000000..536b2be
--- /dev/null
+++ b/.github/workflows/build-sensevoice.yml
@@ -0,0 +1,81 @@
+name: Build Marmalade STT (SenseVoice arm64)
+
+on:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  build:
+    name: Test and build arm64-v8a debug APK
+    runs-on: ubuntu-24.04
+    timeout-minutes: 180
+
+    steps:
+      - name: Checkout including pinned native submodules
+        uses: actions/checkout@v4
+        with:
+          submodules: recursive
+
+      - name: Set up JDK 17
+        uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '17'
+
+      - name: Set up Android SDK
+        uses: android-actions/setup-android@v3
+
+      - name: Install required SDK, NDK and CMake
+        shell: bash
+        run: |
+          sdkmanager --install \
+            'platforms;android-36' \
+            'build-tools;36.0.0' \
+            'ndk;26.3.11579264' \
+            'cmake;3.22.1'
+          yes | sdkmanager --licenses > /dev/null || true
+
+      - name: Configure Gradle cache
+        uses: gradle/actions/setup-gradle@v4
+
+      - name: Verify native submodules
+        shell: bash
+        run: |
+          git submodule status
+          test -f third_party/sherpa-onnx/CMakeLists.txt
+          test -f third_party/marmalade-ui-android/settings.gradle.kts || \
+            test -f third_party/marmalade-ui-android/build.gradle.kts
+
+      - name: Run Android unit tests
+        run: |
+          chmod +x ./gradlew
+          ./gradlew --no-daemon \
+            -PabiFilters=arm64-v8a -PnativeJobs=2 \
+            :app:testFdroidDebugUnitTest
+
+      - name: Build Pixel 8 debug APK
+        run: |
+          ./gradlew --no-daemon \
+            -PabiFilters=arm64-v8a -PnativeJobs=2 \
+            :app:assembleFdroidDebug
+
+      - name: Upload arm64 APK
+        uses: actions/upload-artifact@v4
+        with:
+          name: marmalade-sensevoice-arm64-debug
+          path: app/build/outputs/apk/fdroid/debug/*arm64-v8a*debug.apk
+          if-no-files-found: error
+          retention-days: 14
+
+      - name: Upload test reports if checks fail
+        if: failure()
+        uses: actions/upload-artifact@v4
+        with:
+          name: marmalade-unit-test-reports
+          path: |
+            app/build/reports/tests/
+            app/build/test-results/
+          if-no-files-found: ignore
+          retention-days: 7
